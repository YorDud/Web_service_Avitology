generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SubscriptionLevel {
  free
  basic
  admin
}

enum PaymentProvider {
  test
  yookassa
}

enum PaymentStatus {
  pending
  succeeded
  canceled
  failed
}

model User {
  id                   Int               @id @default(autoincrement())
  publicId             Int?              @unique
  email                String            @unique
  name                 String
  passwordHash         String
  subscriptionLevel    SubscriptionLevel @default(free)
  subscriptionPrice    Int               @default(0)
  subscriptionPaidAt   DateTime?
  subscriptionEndsAt   DateTime?
  usedFreeTrial        Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lastLoginAt          DateTime?
  isActive             Boolean           @default(true)
  notes                String?

  payments             Payment[]
}

model ServiceSettings {
  id                 Int      @id @default(1)
  isYookassaEnabled  Boolean  @default(false)
  isFreeTrialEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Payment {
  id                Int             @id @default(autoincrement())
  userId            Int
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          PaymentProvider @default(test)
  status            PaymentStatus   @default(pending)

  amount            Int
  currency          String          @default("RUB")
  description       String?

  planCode          String?
  durationMonths    Int             @default(1)

  externalPaymentId String?         @unique
  confirmationUrl   String?

  paidAt            DateTime?
  expiresAt         DateTime?
  metadata          String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}