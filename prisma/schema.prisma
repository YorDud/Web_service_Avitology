generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SubscriptionLevel {
  free
  basic
  pro
  admin
}

enum PaymentProvider {
  test
  yookassa
}

enum PaymentStatus {
  pending
  succeeded
  canceled
  failed
}

enum AvitoBidderStatus {
  active
  paused
  attention
}

enum AvitoBidderMode {
  dry_run
  live
}

model User {
  id                 Int               @id @default(autoincrement())
  publicId           Int?              @unique
  email              String            @unique
  name               String
  passwordHash       String
  subscriptionLevel  SubscriptionLevel @default(free)
  subscriptionPrice  Int               @default(0)
  subscriptionPaidAt DateTime?
  subscriptionEndsAt DateTime?
  usedFreeTrial      Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastLoginAt        DateTime?
  isActive           Boolean           @default(true)
  notes              String?
  extensionApiToken  String?           @unique

  payments               Payment[]
  financialRecords       FinancialRecord[]
  avitoSearchAnalyses    AvitoSearchAnalysis[]
  avitoBidders           AvitoBidder[]
  avitoAccountConnection AvitoAccountConnection?
  autoloadFeeds          AutoloadFeed[]
  bonusCodeRedemptions   BonusCodeRedemption[]

  // Дополнительные клиенты автозагрузки (аккаунты Авито кроме основного).
  // autoloadExtraClientSlots — сколько таких клиентов пользователь может завести (+3 за каждую оплату).
  autoloadExtraClientSlots Int              @default(0)
  autoloadClients          AutoloadClient[]

  // Заказы услуги «Уровень сервиса»
  serviceLevelOrders ServiceLevelOrder[]
}

model ServiceSettings {
  id                 Int      @id @default(1)
  isYookassaEnabled  Boolean  @default(false)
  isFreeTrialEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Payment {
  id                Int             @id @default(autoincrement())
  userId            Int
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          PaymentProvider @default(test)
  status            PaymentStatus   @default(pending)
  amount            Int
  currency          String          @default("RUB")
  description       String?
  planCode          String?
  durationMonths    Int             @default(1)
  externalPaymentId String?         @unique
  confirmationUrl   String?
  paidAt            DateTime?
  expiresAt         DateTime?
  metadata          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model FinancialRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordDate String
  name       String   @default("")
  income     Int      @default(0)
  expense    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, recordDate])
}

model AvitoSearchAnalysis {
  id          Int                       @id @default(autoincrement())
  userId      Int
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchQuery String                    @default("")
  searchUrl   String?
  city        String?
  source      String                    @default("extension")
  itemsCount  Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  items       AvitoSearchAnalysisItem[]

  @@index([userId, createdAt])
}

model AvitoSearchAnalysisItem {
  id            Int                 @id @default(autoincrement())
  analysisId    Int
  analysis      AvitoSearchAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  sellerName    String
  firstPosition Int?
  positionsJson String              @default("[]")
  adsCount      Int                 @default(0)
  rating        String?
  reviews       String?
  adsJson       String              @default("[]")
  rawData       String?
  createdAt     DateTime            @default(now())

  @@index([analysisId, firstPosition])
}

model AvitoBidder {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  groupName    String?
  city         String
  query        String
  searchUrl    String?
  avitoItemId  String?
  avitoItemUrl String?

  targetFrom Int
  targetTo   Int

  currentPosition   Int?
  positionSource    String?
  positionCheckedAt DateTime?
  positionSearchUrl String?
  positionPage      Int?
  lastPositionError String?

  currentBid Int @default(0)
  minBid     Int
  maxBid     Int
  bidStep    Int @default(10)

  dailySpendLimit     Int     @default(0)
  spentToday          Int     @default(0)
  smartEconomyEnabled Boolean @default(false)
  spentTodayDate      String?

  checkInterval Int    @default(10)
  schedule      String @default("Ежедневно, 09:00–22:00")

  status        AvitoBidderStatus @default(paused)
  mode          AvitoBidderMode   @default(dry_run)
  changesToday  Int               @default(0)
  nextCheckAt   DateTime?
  lastCheckedAt DateTime?
  lastError     String?

  promotionStrategy        String    @default("bbip")
  promotionDurationDays    Int       @default(7)
  lastPromotionOrderId     String?
  lastPromotionRequestId   String?
  lastPromotionStatus      String?
  lastPromotionPrice       Int?
  lastPromotionOldPrice    Int?
  lastPromotionPayload     String?
  lastForecastPayload      String?
  lastSuggestPayload       String?
  lastAppliedAt            DateTime?
  lastOrderStatusCheckedAt DateTime?
  liveApplyCooldownUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AvitoBidderEvent[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model AvitoBidderEvent {
  id        Int         @id @default(autoincrement())
  bidderId  Int
  bidder    AvitoBidder @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime    @default(now())

  @@index([bidderId, createdAt])
}

model BidderWorkerLock {
  id          String   @id
  token       String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BidderWorkerRun {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  source     String    @default("cron")
  status     String    @default("running")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  processed  Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  total      Int       @default(0)
  message    String?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}

model AvitoAccountConnection {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId              String
  encryptedClientSecret String
  accessTokenEnc        String?

  tokenExpiresAt DateTime?
  lastCheckedAt  DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Дополнительный клиент автозагрузки: отдельный аккаунт Авито со своими ключами,
/// профилем автозагрузки, таблицами и расписанием. Основной аккаунт хранится
/// по-прежнему в AvitoAccountConnection (общий с Бид-менеджером).
model AutoloadClient {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                  String
  clientId              String
  encryptedClientSecret String
  accessTokenEnc        String?

  tokenExpiresAt DateTime?
  lastCheckedAt  DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeds AutoloadFeed[]

  @@index([userId])
}

model AutoloadFeed {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null — таблица основного аккаунта Авито; иначе — таблица дополнительного клиента.
  autoloadClientId Int?
  autoloadClient   AutoloadClient? @relation(fields: [autoloadClientId], references: [id], onDelete: Cascade)

  name        String
  publicToken String  @unique
  linked      Boolean @default(false)
  defaults    Json?
  settings    Json?

  lastFetchedAt DateTime?
  fetchCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads AutoloadAd[]

  @@index([userId])
  @@index([autoloadClientId])
}

model AutoloadAd {
  id     Int          @id @default(autoincrement())
  feedId Int
  feed   AutoloadFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  adKey String
  data  Json

  avitoId       String?
  avitoStatus   String?
  avitoMessages Json?
  syncedAt      DateTime?

  @@unique([feedId, adKey])
  @@index([feedId])
}

model BonusCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  tier         String
  durationDays Int
  isActive     Boolean   @default(true)
  maxUses      Int?
  usedCount    Int       @default(0)
  validFrom    DateTime?
  validUntil   DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  redemptions BonusCodeRedemption[]
}

model BonusCodeRedemption {
  id           Int       @id @default(autoincrement())
  codeId       Int
  code         BonusCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         String
  durationDays Int
  endsAt       DateTime
  redeemedAt   DateTime  @default(now())

  @@unique([codeId, userId])
  @@index([userId])
}

/// Услуга «Уровня сервиса» (актуальность, цена, ответы в чатах и любые новые).
/// Всё редактируется в админ-панели: тексты, цены, шаблон задания для SocPublic.
model ServiceLevelService {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  title     String
  summary   String  @default("")
  /// Подробное описание для инструкции пользователя (если пусто — в инструкции не показывается)
  guide     String  @default("")
  emoji     String  @default("⭐")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Цена на нашем сайте: целых рублей за 1 выполнение на 1 объявление
  pricePerUnit Int @default(25)
  /// Минимум и максимум выполнений на одну ссылку
  minQuantity Int @default(15)
  maxQuantity Int @default(500)

  /// Шаблон названия задания на SocPublic: letter — буква имени, n — номер ссылки в заказе (в фигурных скобках)
  taskTitle        String
  numberSingleLink Boolean @default(true)
  /// Описание задания для исполнителей (HTML)
  taskDescription String
  /// «Информация для подтверждения» (HTML)
  confirmInfo String
  /// Оплата исполнителю за 1 выполнение, ₽
  reward Float @default(5)
  /// «Время на выполнение» в минутах — список значений строго такой же, как в форме SocPublic
  /// (5 мин … 1 месяц). По умолчанию 7200 = 120 ч. (5 дней).
  executionMinutes Int @default(7200)
  /// JSON-шаблон тела запроса task_create (плейсхолдеры name, links, description, confirm, reward и др. в двойных фигурных скобках)
  payloadTemplate String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders ServiceLevelOrder[]
}

/// Общие настройки «Уровня сервиса» (одна строка, id = 1)
model ServiceLevelSettings {
  id Int @id @default(1)

  /// Приём заказов включён (по умолчанию выключен, пока админ не проверил связь с SocPublic)
  isEnabled Boolean @default(false)
  /// Минимальный тариф для заказа: free | basic | pro
  minTier String @default("free")
  /// Комиссия SocPublic сверх выплаты исполнителю, %
  commissionPercent Float @default(30)
  maxLinksPerOrder  Int   @default(20)
  /// Коды успешного ответа API SocPublic через запятую (у SocPublic успех — status 0)
  successCodes String @default("0")
  /// JSON-шаблон тела запроса task_pay (плейсхолдеры taskId, amount, count в двойных фигурных скобках)
  payTemplate String
  /// Ключи (через запятую), по которым ищем числа в ответе task_info
  keyRemaining String @default("left,remain,remaining,rest,ostalos,count_left")
  keyReady     String @default("ready,bids_ready,wait,waiting,pending")
  keyStarted   String @default("started,begin,in_work,bids_started")
  keyRework    String @default("rework,revision,bids_rework")
  keyTotal     String @default("total,all,bids_total")
  keyPaid      String @default("paid,done,completed,success,bids_paid")
  /// Тексты для пользователей
  etaText    String @default("от нескольких часов до 2–3 дней")
  guideIntro String @default("")

  updatedAt DateTime @updatedAt
}

/// Заказ пользователя. Пока не оплачен — статус awaiting_payment и номера нет.
model ServiceLevelOrder {
  id        Int                 @id @default(autoincrement())
  userId    Int
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId Int
  service   ServiceLevelService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// Порядковый номер заказа пользователя (1, 2, 3…), присваивается после оплаты
  orderNumber Int?
  /// awaiting_payment | in_progress | completed | cancelled
  status      String @default("awaiting_payment")

  titleSnapshot   String
  quantityPerLink Int
  linksCount      Int
  totalQuantity   Int
  unitPrice       Int
  /// Сумма заказа, ₽ (то, что платит пользователь)
  amountPaid Int
  /// Расход на SocPublic, ₽
  socCost            Float
  rewardSnapshot     Float
  commissionSnapshot Float

  paymentId Int? @unique

  attention     Boolean @default(false)
  attentionNote String?
  adminNote     String?

  dispatchLockedUntil DateTime?
  paidAt              DateTime?
  completedAt         DateTime?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items ServiceLevelOrderItem[]

  @@unique([userId, orderNumber])
  @@index([userId])
  @@index([status])
}

/// Одна ссылка заказа = одно задание на SocPublic
model ServiceLevelOrderItem {
  id       Int               @id @default(autoincrement())
  orderId  Int
  order    ServiceLevelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  url      String
  quantity Int
  taskName String

  /// pending | creating | created | funding | funded | enabling | active | done | error
  stage      String  @default("pending")
  /// На каком шаге произошла ошибка: create | fund | enable
  errorStage String?
  /// SocPublic просит подождать (лимит на создание заданий) — до этого момента не пробуем сами,
  /// это не ошибка, а обычное ожидание, поэтому заказ не помечается «требует внимания».
  retryAfter DateTime?
  socTaskId  String?
  fundedAmount Float?
  doneCount  Int?
  error      String?
  rawLast    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}
